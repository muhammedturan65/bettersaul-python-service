# BetterSaul Python Service - Production Environment
# Copy to .env and fill in real values

# PostgreSQL + pgvector (Railway provides this)
DATABASE_URL=postgresql://bettersaul:bettersaul@localhost:5432/bettersaul

# Redis (Railway provides this)
REDIS_URL=redis://localhost:6379

# Embedding backend: auto | e5 | openai | tfidf
EMBEDDING_BACKEND=auto

# OpenAI (optional, only if EMBEDDING_BACKEND=openai)
OPENAI_API_KEY=

# CORS - Vercel web URL
CORS_ORIGINS=http://localhost:3000,https://bettersaul-web.vercel.app

# Service
DEBUG=0
WORKERS=1
